<section class="ui-wrap ui-section anvil-quote">
  <div class="anvil-quote__intro">
    <h2>{{ section.settings.heading }}</h2>
    <div class="ui-rte">{{ section.settings.text }}</div>
  </div>
  {% form 'contact', class: 'ui-form anvil-quote__form' %}
    {%- if form.posted_successfully? -%}<p class="ui-form-ok" role="status">{{ section.settings.success }}</p>{%- endif -%}
    {%- if form.errors -%}<p class="ui-form-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    <input type="hidden" name="contact[tags]" value="quote-request">
    <label for="q-company-{{ section.id }}">Company</label>
    <input id="q-company-{{ section.id }}" type="text" name="contact[company]" autocomplete="organization" required>
    <label for="q-name-{{ section.id }}">{{ 'general.name' | t }}</label>
    <input id="q-name-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" required>
    <label for="q-email-{{ section.id }}">{{ 'general.email' | t }}</label>
    <input id="q-email-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required>
    <label for="q-phone-{{ section.id }}">{{ 'general.phone' | t }}</label>
    <input id="q-phone-{{ section.id }}" type="tel" name="contact[phone]" autocomplete="tel">
    <label for="q-body-{{ section.id }}">Parts, quantities and delivery date</label>
    <textarea id="q-body-{{ section.id }}" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
    <button class="ui-btn" type="submit">{{ section.settings.button }}</button>
  {% endform %}
</section>

{% schema %}
{
  "name": "Quote request form",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Request a quote"},
    {"type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell us what you need. Our team replies within one business day.</p>"},
    {"type": "text", "id": "button", "label": "Button label", "default": "Send request"},
    {"type": "text", "id": "success", "label": "Success message", "default": "Thank you. We will respond within one business day."}
  ],
  "presets": [{"name": "Quote request form"}]
}
{% endschema %}
