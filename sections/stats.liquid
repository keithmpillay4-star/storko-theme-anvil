<section class="anvil-stats">
  <ul class="ui-wrap anvil-stats__list" role="list">
    {%- for block in section.blocks -%}
      <li {{ block.shopify_attributes }}>
        <strong>{{ block.settings.value }}</strong>
        <span>{{ block.settings.label }}</span>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Stats",
  "blocks": [
    {"type": "stat", "name": "Stat", "settings": [
      {"type": "text", "id": "value", "label": "Value", "default": "25+"},
      {"type": "text", "id": "label", "label": "Label", "default": "Years in manufacturing"}
    ]}
  ],
  "presets": [{"name": "Stats", "blocks": [
    {"type": "stat", "settings": {"value": "25+", "label": "Years in manufacturing"}},
    {"type": "stat", "settings": {"value": "1,200", "label": "Parts shipped weekly"}},
    {"type": "stat", "settings": {"value": "99.4%", "label": "On-time delivery"}},
    {"type": "stat", "settings": {"value": "ISO 9001", "label": "Certified quality"}}
  ]}]
}
{% endschema %}
